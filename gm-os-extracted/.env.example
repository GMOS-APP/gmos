# =====================
# FRONTEND (Vite - prefix VITE_ to expose to browser)
# =====================

# Your Supabase project URL (found in Supabase dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# =====================
# BACKEND (Vercel API routes - server-side only, never exposed to browser)
# =====================

# Same Supabase URL for server-side routes
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (keep SECRET - has full DB access, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Anthropic API key for Claude LLM features
ANTHROPIC_API_KEY=sk-ant-your-key-here
